
---
import { getCollection } from 'astro:content';

import MasterLayout from '../../layouts/master.astro';
import FilmCard from '../../components/FilmCard.astro';

const films = (await getCollection('films')).sort(
  (a, b) => b.data.releaseOrder - a.data.releaseOrder
);

// Extract the director from the MDX Cast and Crew section
function getDirector(content: string): string | undefined {
  const match = content.match(
    /<div\s+class=["']role["']>\s*Director\s*<\/div>\s*<div\s+class=["']name["']>([\s\S]*?)<\/div>/i
  );

  return match?.[1]?.trim();
}
---

<MasterLayout title="ELEPHANT | Films" description="">
  <h1 class="text-3xl font-light tracking-widest uppercase text-zinc-100 mb-8">
    Films
  </h1>

  {films.map((film) => (
    <FilmCard
      slug={film.slug}
      film={film.data}
      director={getDirector(film.body ?? '')}
    />
  ))}
</MasterLayout>
